#usda 1.0
(
    defaultPrim = "MagSafeScene"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "MagSafeScene" (
    customData = {
        dictionary magsafe = {
            int asset_version = 1
            string class = "magsafe_fixed_scene"
            bool fixed_layout = 1
            bool robot_included = 0
        }
    }
)
{
    def Xform "Table" (
        prepend references = @table_optical.usda@
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Phone" (
        customData = {
            dictionary magsafe = {
                string screen_faces = "-Y"
            }
        }
        prepend references = @phone_landscape.usda@
