        double3 xformOp:translate = (0.525, 0.07642500000000002, 0.83075)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def "Materials"
    {
        def Material "MountPlate"
        {
            token outputs:surface.connect = </MagSafeScene/Materials/MountPlate/PreviewSurface.outputs:surface>

