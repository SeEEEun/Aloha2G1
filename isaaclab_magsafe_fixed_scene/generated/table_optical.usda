#usda 1.0
(
    defaultPrim = "OpticalTable"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "OpticalTable" (
    customData = {
        dictionary magsafe = {
            int asset_version = 1
            string class = "table"
            bool fixed = 1
        }
    }
)
{
    def "Materials"
    {
        def Material "Aluminum"
        {
            token outputs:surface.connect = </OpticalTable/Materials/Aluminum/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.52, 0.54, 0.55)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:metallic = 0.72
                float inputs:opacity = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "BlackFrame"
        {
            token outputs:surface.connect = </OpticalTable/Materials/BlackFrame/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.025, 0.028, 0.03)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:metallic = 0.62
                float inputs:opacity = 1
                float inputs:roughness = 0.27
                token outputs:surface
            }
        }

        def Material "HoleDark"
        {
            token outputs:surface.connect = </OpticalTable/Materials/HoleDark/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015, 0.017, 0.019)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:metallic = 0.25
                float inputs:opacity = 1
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }
    }

