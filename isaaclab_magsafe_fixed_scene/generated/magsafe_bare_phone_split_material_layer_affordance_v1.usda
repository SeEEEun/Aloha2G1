#usda 1.0

def "World"
{
    def "ReplayPhysicsMaterials"
    {
        def Material "InsulatingTape" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.6
            float physics:restitution = 0
            float physics:staticFriction = 0.75
            uniform token physxMaterial:frictionCombineMode = "average"
            uniform token physxMaterial:restitutionCombineMode = "average"
        }

        def Material "BarePhoneRearMatte" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.45
            float physics:restitution = 0
            float physics:staticFriction = 0.55
            uniform token physxMaterial:frictionCombineMode = "average"
            uniform token physxMaterial:restitutionCombineMode = "average"
        }

        def Material "BarePhoneFrontGlass" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.35
            uniform token physxMaterial:frictionCombineMode = "average"
            uniform token physxMaterial:restitutionCombineMode = "average"
        }
    }

    def "MagSafeScene"
    {
        def "Phone"
        {
            over "Colliders"
            {
                over "Main" (
                    prepend apiSchemas = ["PhysicsCollisionAPI"]
                )
                {
                    bool physics:collisionEnabled = 0
                }
            }

            def "BarePhoneCompound"
            {
                def Cube "CentralBody" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </World/ReplayPhysicsMaterials/BarePhoneRearMatte>
                    bool physics:collisionEnabled = 1
                    float physxCollision:contactOffset = 0.0005
                    float physxCollision:restOffset = 0
                    double size = 2
                    float3 xformOp:scale = (0.0748, 0.002975, 0.03575)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "FrontGlass" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </World/ReplayPhysicsMaterials/BarePhoneFrontGlass>
                    bool physics:collisionEnabled = 1
                    float physxCollision:contactOffset = 0.0005
                    float physxCollision:restOffset = 0
                    double size = 2
                    float3 xformOp:scale = (0.0748, 0.0005, 0.03575)
                    double3 xformOp:translate = (0, -0.0034750000000000002, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "RearMatte" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </World/ReplayPhysicsMaterials/BarePhoneRearMatte>
                    bool physics:collisionEnabled = 1
                    float physxCollision:contactOffset = 0.0005
                    float physxCollision:restOffset = 0
                    double size = 2
                    float3 xformOp:scale = (0.0748, 0.0005, 0.03575)
                    double3 xformOp:translate = (0, 0.0034750000000000002, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }
            }
        }
    }

    over "StationaryALOHA"
    {
        over "Asset"
        {
            over "Geometry"
            {
                over "tabletop_link"
                {
                    over "follower_left_base_link"
                    {
                        over "follower_left_link_1"
                        {
                            over "follower_left_link_2"
                            {
                                over "follower_left_link_3"
                                {
                                    over "follower_left_link_4"
                                    {
                                        over "follower_left_link_5"
                                        {
                                            over "follower_left_link_6"
                                            {
                                                over "follower_left_carriage_right"
                                                {
                                                    over "follower_left_gripper_right_pad_upper" (
                                                        prepend apiSchemas = ["MaterialBindingAPI"]
                                                    )
                                                    {
                                                        rel material:binding:physics = </World/ReplayPhysicsMaterials/InsulatingTape>
                                                    }

                                                    over "follower_left_gripper_right_pad_lower" (
                                                        prepend apiSchemas = ["MaterialBindingAPI"]
                                                    )
                                                    {
                                                        rel material:binding:physics = </World/ReplayPhysicsMaterials/InsulatingTape>
                                                    }

                                                    over "follower_left_gripper_right_tip" (
                                                        prepend apiSchemas = ["MaterialBindingAPI"]
                                                    )
                                                    {
                                                        rel material:binding:physics = </World/ReplayPhysicsMaterials/InsulatingTape>
                                                    }
                                                }

                                                over "follower_left_carriage_left"
                                                {
                                                    over "follower_left_gripper_left_pad_upper" (
                                                        prepend apiSchemas = ["MaterialBindingAPI"]
                                                    )
                                                    {
                                                        rel material:binding:physics = </World/ReplayPhysicsMaterials/InsulatingTape>
                                                    }

                                                    over "follower_left_gripper_left_pad_lower" (
                                                        prepend apiSchemas = ["MaterialBindingAPI"]
                                                    )
                                                    {
                                                        rel material:binding:physics = </World/ReplayPhysicsMaterials/InsulatingTape>
                                                    }

                                                    over "follower_left_gripper_left_tip" (
                                                        prepend apiSchemas = ["MaterialBindingAPI"]
                                                    )
                                                    {
                                                        rel material:binding:physics = </World/ReplayPhysicsMaterials/InsulatingTape>
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    over "follower_right_base_link"
                    {
                        over "follower_right_link_1"
                        {
                            over "follower_right_link_2"
                            {
                                over "follower_right_link_3"
                                {
                                    over "follower_right_link_4"
                                    {
                                        over "follower_right_link_5"
                                        {
                                            over "follower_right_link_6"
                                            {
                                                over "follower_right_carriage_right"
                                                {
                                                    over "follower_right_gripper_right_pad_upper" (
                                                        prepend apiSchemas = ["MaterialBindingAPI"]
                                                    )
                                                    {
                                                        rel material:binding:physics = </World/ReplayPhysicsMaterials/InsulatingTape>
                                                    }

                                                    over "follower_right_gripper_right_pad_lower" (
                                                        prepend apiSchemas = ["MaterialBindingAPI"]
                                                    )
                                                    {
                                                        rel material:binding:physics = </World/ReplayPhysicsMaterials/InsulatingTape>
                                                    }

                                                    over "follower_right_gripper_right_tip" (
                                                        prepend apiSchemas = ["MaterialBindingAPI"]
                                                    )
                                                    {
                                                        rel material:binding:physics = </World/ReplayPhysicsMaterials/InsulatingTape>
                                                    }
                                                }

                                                over "follower_right_carriage_left"
                                                {
                                                    over "follower_right_gripper_left_pad_upper" (
                                                        prepend apiSchemas = ["MaterialBindingAPI"]
                                                    )
                                                    {
                                                        rel material:binding:physics = </World/ReplayPhysicsMaterials/InsulatingTape>
                                                    }

                                                    over "follower_right_gripper_left_pad_lower" (
                                                        prepend apiSchemas = ["MaterialBindingAPI"]
                                                    )
                                                    {
                                                        rel material:binding:physics = </World/ReplayPhysicsMaterials/InsulatingTape>
                                                    }

                                                    over "follower_right_gripper_left_tip" (
                                                        prepend apiSchemas = ["MaterialBindingAPI"]
                                                    )
                                                    {
                                                        rel material:binding:physics = </World/ReplayPhysicsMaterials/InsulatingTape>
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

